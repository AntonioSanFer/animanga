# Public URL of the app. Must match the URL users open, including https:// in production.
# SSO callbacks and secure cookies are derived from this value.
BETTER_AUTH_URL=http://localhost:3000

# Optional. If blank, a random secret is generated once and stored in DATA_DIR/secret.
# Recommended: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Generic OIDC / SSO (optional). Discovery URL defaults to ISSUER/.well-known/openid-configuration.
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO

# Optional social logins.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 only for the first local setup/dev. SSO is recommended for production.
AUTH_PASSWORD_ENABLED=0

# Optional extra origins allowed to call the API, comma-separated.
TRUSTED_ORIGINS=

# Docker path; also set by the image. For local dev, comment DATA_DIR out to use ./data.
PORT=3000
DATA_DIR=/app/data

# Download and streaming limits.
MAX_CONCURRENT_DOWNLOADS=2
MAX_ACTIVE_JOBS=25
MAX_STREAMS=3

# On-disk image proxy cache (covers and reader pages), in MB.
MAX_IMAGE_CACHE_MB=1024

# Runtime binaries (included in the Docker image).
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
